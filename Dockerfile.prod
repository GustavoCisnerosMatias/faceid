FROM eclipse-temurin:17-jre-jammy

LABEL maintainer="MDH - Ministerio de Desarrollo Humano"
LABEL description="Sara Service - Reconocimiento Facial FaceNet (PRODUCCIÓN)"
LABEL version="1.0.0"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 sara && useradd -u 1000 -g sara -M -s /bin/sh sara

COPY --chown=sara:sara target/*.jar app.jar

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -sf http://localhost:${SERVER_PORT:-8083}/actuator/health || exit 1

USER sara

EXPOSE 8083

ENV JAVA_OPTS="-Xmx768m -Xms384m -XX:+UseG1GC -XX:MaxGCPauseMillis=200"
ENV SERVER_PORT=8083
ENV SPRING_PROFILES_ACTIVE=production

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar --server.port=${SERVER_PORT}"]
